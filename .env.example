# Copia este archivo como .env (no se sube a git) y completa los valores.
# Base de datos (Supabase > Connect > Session pooler > JDBC)
DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Texto largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET=

# Cuentas iniciales (se crean solo si no existen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=

# Imágenes (Supabase > Project Settings > API Keys > service_role / secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos

CORS_ORIGINS=https://cesarespa.github.io,http://localhost:5520
